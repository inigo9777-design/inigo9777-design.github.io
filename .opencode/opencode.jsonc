{
  "$schema": "https://opencode.ai/config.json", //TODO FIX
  // Use this model by default.
  "model": "ollama/qwen3.8:27b-mlx-code-50k",
  "providers": {
    "ollama": {
      "models": {
        "qwen3.8:27b-mlx-code-50k": {
          "limit": {
            "context": 64000,
            "output": 32000
          }
        }
      }
    }
  },
  //TODO change for the one of playwright to do the UI tests etc
  "mcp": {
    "servers": {
      "jira": {
        "type": "remote",
        "url": "https://jira.example.com/mcp",
        "disabled": true
      }
    }
  },
  "compaction": {
    "auto": true //Lo hace solo al llenarse el contexto
  },
  "instructions": [".opencode/rules/*.md"]
}